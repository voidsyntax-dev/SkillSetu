# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Change this in any shared deployment.
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional AI mentor (Claude). Get a key at console.anthropic.com. Without a key the mentor uses the
# built-in offline engine that answers from the SkillSetu catalog.
ANTHROPIC_API_KEY=""

# Comma-separated emails allowed to open /admin and add custom questions.
ADMIN_EMAILS=""
